{
  "name": "fakestore-api-tests",
  "version": "1.0.0",
  "description": "Framework de automatizacion de pruebas de API para Fake Store API - Reto Tecnico QA Semi Senior, Banco Pichincha",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
